{#
| component.shape | 1=شبكة 3 أعمدة, 2=شبكة أيقونات |
| component.items | (icon, title, text) |
#}
<section class="s-block mudarrib-feat container" data-shape="{{ component.shape|default('1') }}">
    <div class="section-header">
        <h2>{{ component.title|default('ماذا تحصل في الباقة؟') }}</h2>
        <div class="line-glow"></div>
    </div>

    {% if component.shape|default('1') == '1' %}
        <div class="feat-grid">
            {% for item in component.items|default([]) %}
                <div class="feat-item">
                    <div class="feat-ic">{{ item.icon|default('📱') }}</div>
                    <h3>{{ item.title }}</h3>
                    <p>{{ item.text }}</p>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="feat-grid">
            {% for item in component.items|default([]) %}
                <div class="f2">
                    <div class="feat-ic">{{ item.icon|default('📱') }}</div>
                    <div><h3>{{ item.title }}</h3><p>{{ item.text }}</p></div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</section>
