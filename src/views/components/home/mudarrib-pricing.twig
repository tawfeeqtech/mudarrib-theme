{#
| component.shape | 1=3 بطاقات, 2=بطاقة مفردة, 3=أشرطة |
| component.items | (name, period, price, popular, features[]) |
#}
<section class="s-block mudarrib-pricing container" data-shape="{{ component.shape|default('1') }}">
    <div class="section-header">
        <h2>{{ component.title|default('اختر باقتك') }}</h2>
        <div class="line-glow"></div>
    </div>
    {% if component.shape|default('1') == '1' %}
        <div class="pricing-grid">
            {% for item in component.items|default([]) %}
                <div class="price-card {% if item.popular %}popular{% endif %}">
                    {% if item.popular %}<span class="pop-badge">{{ component.popular_label|default('الأكثر طلباً') }}</span>{% endif %}
                    <h3>{{ item.name }}</h3>
                    <p class="p-sub">{{ item.period }}</p>
                    <span class="p-amount">{{ item.price }}</span> <span class="p-currency">{{ component.currency|default('ريال') }}</span>
                    <ul>{% for f in item.features_text|default('')|split('\n') %}{% if f|trim %}<li><span class="ck">✓</span>{{ f|trim }}</li>{% endif %}{% endfor %}</ul>
                    <button class="p-buy">{{ component.btn_label|default('اشترك الآن') }}</button>
                </div>
            {% endfor %}
        </div>
    {% elseif component.shape|default('1') == '2' %}
        {% set single = component.items|default([])|first %}
        <div class="pricing-grid">
            <div class="price-single">
                <div class="ps-img">{{ component.image_icon|default('📋') }}</div>
                <div class="ps-body">
                    <h3>{{ single.name|default('الجدول التدريبي') }}</h3>
                    <p class="p-sub">{{ single.period|default('') }}</p>
                    <ul>{% for f in single.features_text|default('')|split('\n') %}{% if f|trim %}<li><span class="ck">✓</span>{{ f|trim }}</li>{% endif %}{% endfor %}</ul>
                    <p class="p-amount">{{ single.price|default('') }} <span class="p-currency">{{ component.currency|default('ريال') }}</span></p>
                    <button class="p-buy">{{ component.btn_label|default('اشترك الآن') }}</button>
                </div>
            </div>
        </div>
    {% else %}
        <div class="pricing-grid">
            {% for item in component.items|default([]) %}
                <div class="price-bar {% if item.popular %}popular{% endif %}">
                    <div class="pb-name"><h3>{{ item.name }}</h3><p>{{ item.period }}</p></div>
                    <div class="pb-price">{{ item.price }} {{ component.currency|default('ريال') }}</div>
                    <button class="pb-btn">{{ component.btn_label|default('اشترك') }}</button>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</section>
