{#
| component.shape | 1=شريط لوجوهات, 2=شبكة |
| component.items | (name) |
#}
<section class="s-block mudarrib-partners container" data-shape="{{ component.shape|default('1') }}">
    <div class="section-header">
        <h2>{{ component.title|default('عملنا مع') }}</h2>
        <div class="line-glow"></div>
    </div>
    {% if component.shape|default('1') == '1' %}
        <div class="partners-strip">
            {% for item in component.items|default([]) %}
                <div class="partner-logo">{{ item.name }}</div>
            {% endfor %}
        </div>
    {% else %}
        <div class="certs-grid" style="grid-template-columns:repeat(3,1fr)">
            {% for item in component.items|default([]) %}
                <div class="cert-card"><div class="c-ic">🏢</div><h4>{{ item.name }}</h4></div>
            {% endfor %}
        </div>
    {% endif %}
</section>
