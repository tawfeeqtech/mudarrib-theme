{#
| component.shape | 1=جدول, 2=بطاقات أيام |
| component.rows | (day, slots[]) حيث slot=(time, name, booked) |
#}
<section class="s-block mudarrib-schedule container" data-shape="{{ component.shape|default('1') }}">
    <div class="section-header">
        <h2>{{ component.title|default('جدول الحصص الأسبوعي') }}</h2>
        <div class="line-glow"></div>
    </div>
    {% if component.shape|default('1') == '1' %}
        <table class="sched-table">
            <tr><th>اليوم</th>{% for t in component.times|default(['6 صباحاً','4 عصراً','8 مساءً']) %}<th>{{ t }}</th>{% endfor %}</tr>
            {% for row in component.rows|default([]) %}
                <tr><td>{{ row.day }}</td>{% for s in row.slots|default([]) %}<td class="{{ s.booked ? 'booked' : '' }}">{{ s.name ?: '—' }}</td>{% endfor %}</tr>
            {% endfor %}
        </table>
        {% if component.note %}<p class="sched-note">{{ component.note }}</p>{% endif %}
    {% else %}
        <div class="sched-grid">
            {% for row in component.rows|default([]) %}
                <div class="day-card"><h4>{{ row.day }}</h4><ul>{% for s in row.slots|default([]) %}{% if s.name %}<li>{{ s.time }} — {{ s.name }}</li>{% endif %}{% endfor %}</ul></div>
            {% endfor %}
        </div>
    {% endif %}
</section>
