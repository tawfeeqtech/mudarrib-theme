{#
| component.shape | 1=شبكة بطاقات, 2=قائمة |
| component.items | (icon, title, text) |
#}
<section class="s-block mudarrib-why container" data-shape="{{ component.shape|default('1') }}">
    <div class="section-header">
        <h2>{{ component.title|default(trans('mudarrib.why.title')) }}</h2>
        <div class="line-glow"></div>
    </div>

    {% if component.shape|default('1') == '1' %}
        <div class="why-grid">
            {% for item in component.items|default([]) %}
                <div class="why-card">
                    <div class="why-ic">{{ item.icon|default('🎯') }}</div>
                    <h3>{{ item.title }}</h3>
                    <p>{{ item.text }}</p>
                </div>
            {% endfor %}
        </div>
    {% else %}
        {% for item in component.items|default([]) %}
            <div class="why-row">
                <div class="why-ic">{{ item.icon|default('🎯') }}</div>
                <div><h3>{{ item.title }}</h3><p>{{ item.text }}</p></div>
            </div>
        {% endfor %}
    {% endif %}
</section>
