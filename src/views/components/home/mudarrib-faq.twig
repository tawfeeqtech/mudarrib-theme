{#
| component.shape | 1=عمودان, 2=عمود واحد |
| component.items | (question, answer) |
#}
<section class="s-block mudarrib-faq container" data-shape="{{ component.shape|default('1') }}">
    <div class="section-header">
        <h2>{{ component.title|default('الأسئلة الشائعة') }}</h2>
        <div class="line-glow"></div>
    </div>
    <div class="faq-grid">
        {% for item in component.items|default([]) %}
            <div class="acc-item" onclick="this.classList.toggle('active')">
                <div class="acc-header">{{ item.question }} <span>+</span></div>
                <div class="acc-content">{{ item.answer }}</div>
            </div>
        {% endfor %}
    </div>
</section>
