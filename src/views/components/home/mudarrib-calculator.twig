{#
| component.shape | 1=نموذج, 2=بنتيجة بارزة |
| component.items | (label, options_text) حيث options_text كل سطر خيار |
| component.result_price / result_label |
#}
<section class="s-block mudarrib-calc container" data-shape="{{ component.shape|default('1') }}">
    <div class="section-header">
        <h2>{{ component.title|default(trans('mudarrib.calculator.title')) }}</h2>
        <div class="line-glow"></div>
    </div>
    <div class="calc-box">
        {% for f in component.items|default([]) %}
            <div class="calc-field">
                <label>{{ f.label }}</label>
                <div class="mud-select" data-placeholder="{{ f.placeholder|default(trans('mudarrib.common.select')) }}">
                    <div class="mud-select__trigger">
                        <span class="mud-select__value is-placeholder">{{ f.placeholder|default(trans('mudarrib.common.select')) }}</span>
                        <svg class="mud-select__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                    </div>
                    <div class="mud-select__menu">
                        {% for opt in f.options_text|default('')|split('\n') %}
                            {% if opt|trim %}<div class="mud-select__option" data-value="{{ opt|trim }}">{{ opt|trim }}</div>{% endif %}
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% endfor %}
        {% if component.shape|default('1') == '2' %}<button class="quiz-submit">{{ component.btn_label|default(trans('mudarrib.calculator.btn')) }}</button>{% endif %}
        <div class="calc-result">
            <div class="price">{{ component.result_price|default('349') }} {{ component.currency|default(trans('mudarrib.common.currency')) }}</div>
            <div class="lbl">{{ component.result_label|default(trans('mudarrib.calculator.result')) }}</div>
        </div>
    </div>
</section>
