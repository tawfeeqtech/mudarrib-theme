{#
| component.shape | 1=شبكة 6, 2=شبكة 4 |
| component.items | (image, icon) |
| component.handle |
#}
<section class="s-block mudarrib-insta container" data-shape="{{ component.shape|default('1') }}">
    <div class="section-header">
        <h2>{{ component.title|default('تابعنا على انستغرام') }}</h2>
        <div class="line-glow"></div>
    </div>
    <div class="insta-grid" {% if component.shape|default('1') == '2' %}style="grid-template-columns:repeat(4,1fr)"{% endif %}>
        {% for item in component.items|default([]) %}
            <div class="insta-item">{% if item.image %}<img src="{{ item.image }}" alt="">{% else %}{{ item.icon|default('🏋️') }}{% endif %}</div>
        {% endfor %}
    </div>
    {% if component.handle %}<div class="insta-handle">{{ component.handle }}</div>{% endif %}
</section>
